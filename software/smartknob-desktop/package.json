{
  "name": "smartknob-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A virtual desktop with twelve knob-controlled apps",
  "scripts": {
    "prepare:assets": "node prepare.mjs",
    "dev": "node prepare.mjs && vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "node prepare.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "protobufjs-cli": "^2.7.0",
    "vite": "^8.3.2"
  }
}
